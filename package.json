{
  "name": "recording-monitor-for-atem",
  "version": "0.2.1",
  "description": "Recording monitor for Blackmagic ATEM switchers: shows recording status and alerts you when recording stops",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "probe": "node tools/probe.js",
    "dist:win": "electron-builder --win portable nsis --x64",
    "dist:mac": "electron-builder --mac dir",
    "smoke-test": "node tools/smoke-test.js"
  },
  "keywords": [],
  "author": "FEDEVEL",
  "license": "CC-BY-NC-SA-4.0",
  "type": "commonjs",
  "dependencies": {
    "atem-connection": "3.11.1"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "productName": "Recording Monitor for ATEM",
  "build": {
    "appId": "com.fedevel.recordingmonitorforatem",
    "productName": "Recording Monitor for ATEM",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json",
      "build/icon.png",
      "LICENSE"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Recording-Monitor-for-ATEM-${version}-portable.exe"
    },
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FEDEVEL/recording-monitor-for-atem.git"
  },
  "homepage": "https://github.com/FEDEVEL/recording-monitor-for-atem"
}
